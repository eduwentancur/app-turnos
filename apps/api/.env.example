NODE_ENV=development
PORT=3001
DATABASE_URL="postgresql://turnos:turnos_dev@localhost:5433/turnos?schema=public"
WEB_ORIGIN=http://localhost:3000

# Auth — generá un secreto propio: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false

# WhatsApp Cloud API (developers.facebook.com → tu app → WhatsApp → Configuración de la API)
# Inventá un texto largo para WHATSAPP_VERIFY_TOKEN y usá el mismo al configurar el webhook en Meta.
WHATSAPP_VERIFY_TOKEN=
# Configuración de la app → Básica → Clave secreta de la app
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BARBERSHOP_SLUG=barberia-bf
WHATSAPP_GRAPH_VERSION=v25.0

# Audios: se transcriben en el servidor con Whisper (gratis). La primera vez descarga el modelo (~250 MB).
TRANSCRIPTION_ENABLED=true
TRANSCRIPTION_MODEL=onnx-community/whisper-small
TRANSCRIPTION_MAX_SECONDS=90
